url: "https://georgevrs.github.io/quant-notebook/"
license: MIT
keywords:
  - quantitative finance
  - algorithmic trading
  - backtesting
  - portfolio construction
  - machine learning
  - course
version: "0.1.0"
date-released: "2026-09-26"
